#!/bin/sh

MODULES_DIR="/lib/modules/`uname -r`"

start() {
    echo "enable android usb"

    killall adbd 2>/dev/null

    insmod $MODULES_DIR/libcomposite.ko
    insmod $MODULES_DIR/usb_f_mass_storage.ko
    insmod $MODULES_DIR/usb_f_fs.ko

    setusbconfig adb
    export ADB_TRANSPORT_PORT=5555
    adbd > /dev/null &
}

stop() {
    echo "disable android usb"

    killall adbd 2>/dev/null

    setusbconfig none

   rmmod $MODULES_DIR/usb_f_fs.ko
   rmmod $MODULES_DIR/usb_f_mass_storage.ko
   rmmod $MODULES_DIR/libcomposite.ko
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?

