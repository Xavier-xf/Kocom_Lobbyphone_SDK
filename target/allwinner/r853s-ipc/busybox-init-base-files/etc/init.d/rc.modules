#!/bin/sh

echo "------run rc.modules file-----"
cat /sys/devices/platform/soc/usbc0/usb_host
insmod /lib/modules/4.9.191/ssv6x5x.ko stacfgpath="/lib/firmware/ssv6x5x-wifi.cfg"

#insmod sound modules
