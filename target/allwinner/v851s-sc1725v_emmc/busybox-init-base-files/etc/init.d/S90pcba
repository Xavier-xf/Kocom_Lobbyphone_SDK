#!/bin/sh
#
# S01app....
#

start() {
    	printf "Load S90pcba\n"	
	
	#set usb host
	#cat /sys/devices/platform/soc/usbc0/usb_host
	
	/usr/bin/bt_test -p gatt-server
	
	if [ -d /mnt/SDCARD/pcba_test ]; then	
		/usr/bin/pcba_test.sh
	fi
}

stop() {
    printf "Unload S01app\n"
}

case "$1" in
    start)
	start
	;;
    stop)
	stop
	;;
    restart|reload)
	stop
	start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
