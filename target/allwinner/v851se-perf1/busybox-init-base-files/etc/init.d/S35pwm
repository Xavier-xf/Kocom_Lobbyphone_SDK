#/bin/sh
#
# Load mmc modules....
#

MODULES_DIR="/lib/modules/`uname -r`"

start() {
    printf "Load pwm  modules\n"
    insmod $MODULES_DIR/pwm-sunxi-group.ko
}

stop() {
    printf "Unload nfs modules\n"
    rmmod $MODULES_DIR/pwm-sunxi-group.ko
}

case "$1" in
    start)
	start
	;;
    stop)
	stop
	;;
    restart|reload)
	stop
	start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
